<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>Mira Aoki · Creative Technologist</title>
    <meta
      name="description"
      content="Independent creative technologist working between distributed systems, expressive interfaces, and the strange territory where they meet."
    />
    <meta property="og:title" content="Mira Aoki · Creative Technologist" />
    <meta
      property="og:description"
      content="Independent creative technologist working between distributed systems, expressive interfaces, and the strange territory where they meet."
    />
    <meta property="og:type" content="website" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%2334d399'/%3E%3Ctext x='16' y='22' font-family='system-ui' font-size='18' font-weight='600' text-anchor='middle' fill='%230a0a0a'%3EM%3C/text%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ["Geist", "ui-sans-serif", "system-ui", "sans-serif"],
              mono: [
                '"Geist Mono"',
                "ui-monospace",
                "SFMono-Regular",
                "monospace",
              ],
            },
            colors: {
              bg: "#0a0a0a",
              surface: "#111111",
              hairline: "rgba(255,255,255,0.08)",
              ink: {
                50: "#fafaf9",
                100: "#f5f5f4",
                200: "#e7e5e4",
                300: "#d6d3d1",
                400: "#a8a29e",
                500: "#78716c",
                600: "#57534e",
                700: "#3a3531",
                800: "#272421",
                900: "#1a1816",
              },
              accent: {
                DEFAULT: "#34d399",
                dim: "#10b981",
              },
            },
            transitionTimingFunction: {
              spring: "cubic-bezier(0.32, 0.72, 0, 1)",
              "out-expo": "cubic-bezier(0.16, 1, 0.3, 1)",
            },
          },
        },
      };
    </script>
    <style>
      html {
        scroll-behavior: smooth;
      }
      body {
        background: #0a0a0a;
        color: #f5f5f4;
        font-family: "Geist", ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }
      ::selection {
        background: #34d399;
        color: #0a0a0a;
      }
      .text-balance {
        text-wrap: balance;
      }

      /* Fixed grain overlay, pointer-events-none, GPU-safe */
      .grain-overlay {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 60;
        opacity: 0.04;
        mix-blend-mode: overlay;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      }

      /* Hero radial mesh, fixed to section */
      .hero-mesh {
        background-image:
          radial-gradient(
            ellipse 80% 60% at 15% -10%,
            rgba(52, 211, 153, 0.1),
            transparent 60%
          ),
          radial-gradient(
            ellipse 60% 50% at 90% 20%,
            rgba(96, 165, 250, 0.06),
            transparent 60%
          ),
          radial-gradient(
            ellipse 50% 40% at 50% 100%,
            rgba(52, 211, 153, 0.04),
            transparent 60%
          );
      }

      /* Double bezel (Doppelrand) - outer shell */
      .bezel {
        position: relative;
        background: rgba(255, 255, 255, 0.025);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 28px;
        padding: 1.5px;
        transition:
          border-color 500ms cubic-bezier(0.32, 0.72, 0, 1),
          background 500ms cubic-bezier(0.32, 0.72, 0, 1);
      }
      .bezel:hover {
        border-color: rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.04);
      }
      .bezel-inner {
        background: linear-gradient(180deg, #131313 0%, #0d0d0d 100%);
        border-radius: calc(28px - 1.5px);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
        overflow: hidden;
      }
      .bezel-lg {
        border-radius: 32px;
        padding: 2px;
      }
      .bezel-lg .bezel-inner {
        border-radius: calc(32px - 2px);
      }

      /* Pill button with nested icon (button-in-button pattern) */
      .btn-primary {
        display: inline-flex;
        align-items: center;
        padding: 4px 4px 4px 20px;
        background: #f5f5f4;
        color: #0a0a0a;
        border-radius: 999px;
        font-weight: 500;
        font-size: 14px;
        letter-spacing: -0.01em;
        transition:
          transform 400ms cubic-bezier(0.32, 0.72, 0, 1),
          background 400ms cubic-bezier(0.32, 0.72, 0, 1);
        white-space: nowrap;
      }
      .btn-primary .btn-icon {
        width: 32px;
        height: 32px;
        background: #0a0a0a;
        color: #f5f5f4;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: 12px;
        transition: transform 400ms cubic-bezier(0.32, 0.72, 0, 1);
      }
      .btn-primary:hover .btn-icon {
        transform: translate(2px, -2px) rotate(0deg);
      }
      .btn-primary:hover {
        background: #ffffff;
      }
      .btn-primary:active {
        transform: scale(0.98);
      }

      .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 18px;
        color: #f5f5f4;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 999px;
        font-weight: 500;
        font-size: 14px;
        background: rgba(255, 255, 255, 0.02);
        transition: all 400ms cubic-bezier(0.32, 0.72, 0, 1);
        white-space: nowrap;
      }
      .btn-ghost:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.22);
      }
      .btn-ghost:active {
        transform: scale(0.98);
      }

      /* Floating glass nav pill */
      .nav-pill {
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        background: rgba(10, 10, 10, 0.65);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.06),
          0 10px 40px rgba(0, 0, 0, 0.4);
      }

      /* Scroll reveal */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        filter: blur(8px);
        transition:
          opacity 900ms cubic-bezier(0.16, 1, 0.3, 1),
          transform 900ms cubic-bezier(0.16, 1, 0.3, 1),
          filter 900ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal.in {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
      .reveal-d1 {
        transition-delay: 80ms;
      }
      .reveal-d2 {
        transition-delay: 160ms;
      }
      .reveal-d3 {
        transition-delay: 240ms;
      }
      .reveal-d4 {
        transition-delay: 320ms;
      }
      .reveal-d5 {
        transition-delay: 400ms;
      }

      /* Marquee */
      @keyframes marquee {
        from {
          transform: translate3d(0, 0, 0);
        }
        to {
          transform: translate3d(-50%, 0, 0);
        }
      }
      .marquee-track {
        animation: marquee 48s linear infinite;
        will-change: transform;
      }
      .marquee-mask {
        mask-image: linear-gradient(
          90deg,
          transparent 0%,
          black 8%,
          black 92%,
          transparent 100%
        );
        -webkit-mask-image: linear-gradient(
          90deg,
          transparent 0%,
          black 8%,
          black 92%,
          transparent 100%
        );
      }

      /* Project card hover */
      .project-card .project-image {
        transition: transform 800ms cubic-bezier(0.32, 0.72, 0, 1);
      }
      .project-card:hover .project-image {
        transform: scale(1.04);
      }

      /* Tech stack logo row */
      .stack-logos {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .stack-logo {
        width: 18px;
        height: 18px;
        flex: 0 0 18px;
        opacity: 0.7;
        transition: opacity 400ms cubic-bezier(0.32, 0.72, 0, 1);
      }
      .project-card:hover .stack-logo {
        opacity: 1;
      }

      .project-card .project-arrow {
        transition:
          transform 400ms cubic-bezier(0.32, 0.72, 0, 1),
          background 400ms cubic-bezier(0.32, 0.72, 0, 1);
      }
      .project-card:hover .project-arrow {
        transform: translate(2px, -2px);
        background: #34d399;
        color: #0a0a0a;
      }

      /* Category card (tech stack) */
      .cat-card-visual {
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 16 / 10;
        position: relative;
        background-image: radial-gradient(
          ellipse 80% 70% at 20% 0%,
          rgba(52, 211, 153, 0.1),
          transparent 60%
        );
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }
      .cat-card-visual h3 {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 500;
        letter-spacing: -0.04em;
        line-height: 1;
      }
      .cat-card-visual--short {
        aspect-ratio: 16 / 9;
      }
      .cat-card-visual--tall {
        aspect-ratio: 16 / 11;
      }
      .stack-logos-lg {
        gap: 14px;
      }
      .stack-logos-lg .stack-logo {
        width: 26px;
        height: 26px;
        flex: 0 0 26px;
      }

      /* Skill row accordion: chevron + note driven by aria-expanded */
      .skill-row[aria-expanded="true"] .skill-chevron {
        transform: rotate(180deg);
      }
      .skill-row[aria-expanded="true"] + .skill-note {
        grid-template-rows: 1fr;
      }
      .skill-row:hover {
        background: rgba(255, 255, 255, 0.025);
      }
      .skill-row {
        transition: background 400ms cubic-bezier(0.32, 0.72, 0, 1);
      }

      /* Status dot pulse (real semantic state only) */
      @keyframes pulse-dot {
        0%,
        100% {
          opacity: 1;
          transform: scale(1);
        }
        50% {
          opacity: 0.5;
          transform: scale(0.85);
        }
      }
      .pulse-dot {
        animation: pulse-dot 2.4s ease-in-out infinite;
      }

      /* Subtle gradient text */
      .text-gradient {
        background: linear-gradient(135deg, #f5f5f4 0%, #a8a29e 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      /* Hairline divider */
      .hairline {
        border-color: rgba(255, 255, 255, 0.08);
      }

      /* Skill list dividers: darker + thinner than default hairline */
      .skill-divide > li + li {
        border-top: 1px solid rgba(150, 150, 150, 0.35);
      }

      /* Tabular nums for stats */
      .stat-num {
        font-feature-settings:
          "tnum" 1,
          "lnum" 1;
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
          scroll-behavior: auto !important;
        }
        .reveal {
          opacity: 1;
          transform: none;
          filter: none;
        }
        .marquee-track {
          animation: none;
        }
        .pulse-dot {
          animation: none;
        }
      }

      /* Focus visible for keyboard */
      :focus-visible {
        outline: 2px solid #34d399;
        outline-offset: 3px;
        border-radius: 4px;
      }
      a:focus-visible,
      button:focus-visible {
        outline-offset: 4px;
      }

      /* GitHub contribution heatmap */
      .gh-grid {
        display: grid;
        grid-template-rows: repeat(7, 12px);
        grid-auto-flow: column;
        grid-template-columns: repeat(53, minmax(0, 1fr));
        gap: 3px;
        width: 100%;
      }
      .gh-cell {
        width: 100%;
        height: 12px;
        aspect-ratio: 1 / 1;
        border-radius: 3px;
        border: 0;
        padding: 0;
        cursor: default;
      }
      .gh-scroll {
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none;
        -ms-overflow-style: none;
        -webkit-overflow-scrolling: touch;
      }
      .gh-scroll::-webkit-scrollbar {
        display: none;
      }
      .gh-skel {
        background: rgba(255, 255, 255, 0.04);
      }

      .gh-month {
        font-family: "Geist Mono", ui-monospace, monospace;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #78716c;
      }

      .gh-legend-swatch {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        display: inline-block;
      }

      /* Coding stats section */
      .cs-row {
        display: grid;
        grid-template-columns: 2rem 1fr auto auto;
        gap: 0.75rem;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }
      .cs-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }
      .cs-row:first-of-type {
        padding-top: 0;
      }
      .cs-rank {
        font-family: "Geist Mono", ui-monospace, monospace;
        font-size: 0.6875rem;
        font-weight: 500;
        color: #78716c;
        background: rgba(255, 255, 255, 0.04);
        padding: 0.25rem 0.5rem;
        border-radius: 9999px;
        text-align: center;
      }
      .cs-lang {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
      }
      .cs-lang-name {
        font-weight: 500;
        font-size: 0.9375rem;
        color: #f5f5f4;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .cs-bar {
        width: 100%;
        height: 4px;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 2px;
        overflow: hidden;
      }
      .cs-fill {
        height: 100%;
        background: linear-gradient(90deg, #34d399 0%, #10b981 100%);
        border-radius: 2px;
        transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .cs-time {
        font-family: "Geist Mono", ui-monospace, monospace;
        font-size: 0.875rem;
        font-weight: 500;
        color: #f5f5f4;
        white-space: nowrap;
        text-align: right;
        min-width: 3.5rem;
      }
      .cs-percent {
        font-family: "Geist Mono", ui-monospace, monospace;
        font-size: 0.75rem;
        color: #78716c;
        white-space: nowrap;
        text-align: right;
        min-width: 2.5rem;
      }
      .cs-skel {
        background: linear-gradient(
          90deg,
          rgba(255, 255, 255, 0.04) 0%,
          rgba(255, 255, 255, 0.08) 50%,
          rgba(255, 255, 255, 0.04) 100%
        );
        background-size: 200% 100%;
        animation: cs-shimmer 1.5s infinite;
      }
      @keyframes cs-shimmer {
        0% {
          background-position: 200% 0;
        }
        100% {
          background-position: -200% 0;
        }
      }
      .cs-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        margin-bottom: 0.5rem;
      }
      .cs-total {
        font-family: "Geist Mono", ui-monospace, monospace;
        font-size: 0.8125rem;
        color: #a8a29e;
      }
      .cs-total-value {
        color: #f5f5f4;
        font-weight: 500;
      }
      @media (max-width: 640px) {
        .cs-row {
          grid-template-columns: 1.75rem 1fr;
          gap: 0.5rem;
        }
        .cs-time,
        .cs-percent {
          display: none;
        }
        .cs-lang-name {
          font-size: 0.875rem;
        }
      }
    </style>
  </head>
  <body class="bg-bg text-ink-100 font-sans">
    <!-- Fixed grain overlay (GPU-safe, pointer-events-none) -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <!-- Skip to content (a11y) -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[80] focus:px-4 focus:py-2 focus:bg-accent focus:text-bg focus:rounded-full focus:text-sm focus:font-medium"
      >Skip to content</a
    >

    <!-- Floating glass nav -->
    <header
      class="fixed top-5 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-1.5rem)] max-w-3xl"
    >
      <nav
        class="nav-pill rounded-full px-2 py-2 flex items-center justify-between"
        aria-label="Primary"
      >
        <a href="#top" class="flex items-center gap-2.5 pl-3 pr-4 py-1.5">
          <span
            class="w-7 h-7 rounded-full bg-accent flex items-center justify-center text-bg font-semibold text-sm"
            >M</span
          >
          <span class="font-medium text-sm tracking-tight">Mira Aoki</span>
        </a>
        <ul class="hidden md:flex items-center gap-1 text-sm">
          <li>
            <a
              href="#work"
              class="px-3 py-1.5 text-ink-300 hover:text-ink-100 transition-colors duration-300 rounded-full"
              >Work</a
            >
          </li>
          <li>
            <a
              href="#approach"
              class="px-3 py-1.5 text-ink-300 hover:text-ink-100 transition-colors duration-300 rounded-full"
              >Approach</a
            >
          </li>
          <li>
            <a
              href="#notes"
              class="px-3 py-1.5 text-ink-300 hover:text-ink-100 transition-colors duration-300 rounded-full"
              >Notes</a
            >
          </li>
        </ul>
        <a href="#contact" class="btn-primary" aria-label="Start a project">
          <span class="hidden sm:inline">Start a project</span>
          <span class="sm:hidden">Contact</span>
          <span class="btn-icon" aria-hidden="true">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M7 17L17 7" />
              <path d="M7 7h10v10" />
            </svg>
          </span>
        </a>
      </nav>
    </header>

    <main id="main">
      <!-- HERO (Editorial Split) -->
      <section
        id="top"
        class="relative min-h-[100dvh] hero-mesh pt-28 md:pt-32 pb-20 md:pb-24 px-6 md:px-10"
      >
        <div
          class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center"
        >
          <!-- Left: identity + headline -->
          <div class="lg:col-span-7">
            <div class="reveal">
              <p
                class="font-mono text-[11px] uppercase tracking-[0.22em] text-ink-400 mb-7 inline-flex items-center gap-2.5"
              >
                <span
                  class="w-1.5 h-1.5 rounded-full bg-accent pulse-dot"
                  aria-hidden="true"
                ></span>
                Available for select work, Q1 2026
              </p>
            </div>

            <h1
              class="reveal reveal-d1 text-balance text-[clamp(2.75rem,6.8vw,6.25rem)] font-medium tracking-[-0.04em] leading-[0.96] mb-8"
            >
              Building resilient systems and the
              <span
                class="text-accent italic font-medium"
                style="font-feature-settings: &quot;ss01&quot;"
                >interfaces</span
              >
              that make them legible.
            </h1>

            <p
              class="reveal reveal-d2 text-lg md:text-xl text-ink-300 max-w-2xl leading-[1.55] mb-10"
            >
              I am Mira, an independent creative technologist working between
              distributed systems, expressive UI, and the strange territory
              where they meet.
            </p>

            <div class="reveal reveal-d3 flex flex-wrap items-center gap-3">
              <a href="#contact" class="btn-primary">
                <span>Start a project</span>
                <span class="btn-icon" aria-hidden="true">
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M7 17L17 7" />
                    <path d="M7 7h10v10" />
                  </svg>
                </span>
              </a>
              <a href="#work" class="btn-ghost">
                <span>View selected work</span>
              </a>
            </div>
          </div>

          <!-- Right: identity card -->
          <div class="lg:col-span-5 reveal reveal-d2">
            <div class="bezel">
              <div class="bezel-inner p-6 md:p-7">
                <div class="flex items-start justify-between mb-7">
                  <div>
                    <p
                      class="font-mono text-[10px] uppercase tracking-[0.22em] text-ink-500 mb-1.5"
                    >
                      Now
                    </p>
                    <p class="text-sm text-ink-200">
                      Working from <span class="text-ink-100">Kyoto</span>, JST
                    </p>
                  </div>
                  <div
                    class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-accent/10 border border-accent/25"
                  >
                    <span
                      class="w-1.5 h-1.5 rounded-full bg-accent pulse-dot"
                      aria-hidden="true"
                    ></span>
                    <span
                      class="font-mono text-[9.5px] uppercase tracking-[0.18em] text-accent"
                      >Open</span
                    >
                  </div>
                </div>

                <div
                  class="aspect-[4/5] rounded-2xl overflow-hidden bg-ink-800 relative mb-6"
                >
                  <img
