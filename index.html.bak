                      <svg
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M7 17L17 7" />
                        <path d="M7 7h10v10" />
                      </svg>
                    </span>
                  </a>
                  <a href="#" class="btn-ghost">
                    <span>Read my writing</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="px-6 md:px-10 py-10 md:py-12 border-t hairline">
      <div
        class="max-w-7xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-6"
      >
        <div class="flex items-center gap-3">
          <span
            class="w-7 h-7 rounded-full bg-accent flex items-center justify-center text-bg font-semibold text-sm"
            aria-hidden="true"
            >M</span
          >
          <div>
            <p class="text-sm font-medium">Mira Aoki</p>
            <p class="text-xs text-ink-400 font-mono">
              Kyoto, JP · JST (UTC+09:00)
            </p>
          </div>
        </div>

        <nav
          aria-label="Social"
          class="flex items-center gap-5 text-sm text-ink-300"
        >
          <a href="#" class="hover:text-ink-100 transition-colors duration-300"
            >GitHub</a
          >
          <a href="#" class="hover:text-ink-100 transition-colors duration-300"
            >Read.cv</a
          >
          <a href="#" class="hover:text-ink-100 transition-colors duration-300"
            >Mastodon</a
          >
          <a
            href="mailto:hello@miraaoki.com"
            class="hover:text-ink-100 transition-colors duration-300"
            >Email</a
          >
        </nav>

        <p class="text-xs text-ink-500 font-mono">© 2026 Mira Aoki</p>
      </div>
    </footer>

    <!-- Scroll-reveal via IntersectionObserver (no scroll listener) -->
    <script>
      (function () {
        const els = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) {
          els.forEach(function (el) {
            el.classList.add("in");
          });
          return;
        }
        const obs = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -6% 0px" },
        );
        els.forEach(function (el) {
          obs.observe(el);
        });
      })();

      // Projects tab switcher
      (function () {
        var tabs = document.querySelectorAll(".tab-btn");
        var grid = document.getElementById("projects-grid");
        var cards = document.querySelectorAll("[data-cat]");
        if (!tabs.length || !grid) return;

        function activate(name) {
          tabs.forEach(function (t) {
            var active = t.getAttribute("data-tab") === name;
            t.setAttribute("aria-selected", active ? "true" : "false");
            if (active) {
              t.className =
                "tab-btn px-5 py-2 rounded-full text-sm font-medium bg-accent text-bg transition-all duration-400 ease-spring";
            } else {
              t.className =
                "tab-btn px-5 py-2 rounded-full text-sm font-medium border hairline bg-ink-50/5 text-ink-200 hover:bg-ink-50/10 hover:text-ink-100 transition-all duration-400 ease-spring";
            }
          });

          cards.forEach(function (c) {
            var match = name === "all" || c.getAttribute("data-cat") === name;
            c.classList.toggle("hidden", !match);
          });
        }

        tabs.forEach(function (t) {
          t.addEventListener("click", function () {
            activate(t.getAttribute("data-tab"));
          });
          t.addEventListener("keydown", function (e) {
            var keys = ["ArrowRight", "ArrowLeft", "Home", "End"];
            if (keys.indexOf(e.key) === -1) return;
            var list = Array.prototype.slice.call(tabs);
            var idx = list.indexOf(t);
            if (e.key === "ArrowRight") idx = (idx + 1) % list.length;
            if (e.key === "ArrowLeft")
              idx = (idx - 1 + list.length) % list.length;
            if (e.key === "Home") idx = 0;
            if (e.key === "End") idx = list.length - 1;
            list[idx].focus();
            list[idx].click();
            e.preventDefault();
          });
        });
      })();

      // Skill accordion: toggle note panel per row
      (function () {
        var rows = document.querySelectorAll(".skill-row");
        if (!rows.length) return;
        rows.forEach(function (btn) {
          btn.addEventListener("click", function () {
            var expanded = btn.getAttribute("aria-expanded") === "true";
            btn.setAttribute("aria-expanded", expanded ? "false" : "true");
            var note = btn.parentElement.querySelector(".skill-note");
            if (note) {
              note.classList.toggle("grid-rows-[1fr]", !expanded);
              note.classList.toggle("grid-rows-[0fr]", expanded);
            }
          });
        });
      })();

      // GitHub contribution heatmap (live fetch + stats)
      (function () {
        var USERNAME = "sysFaisal";
        var ENDPOINT =
          "https://api.github.com/users/" + USERNAME + "/contributions";
        var TIMEOUT_MS = 4000;

        var grid = document.getElementById("gh-heatmap");
        if (!grid) return;

        var SKELETON_COUNT = 371;
        var LEVELS = [
          "rgba(255,255,255,0.04)",
          "rgba(57,211,83,0.18)",
          "rgba(57,211,83,0.40)",
          "rgba(57,211,83,0.70)",
          "#39d353",
        ];

        function paintSkeleton() {
          var frag = document.createDocumentFragment();
          for (var i = 0; i < SKELETON_COUNT; i++) {
            var s = document.createElement("div");
            s.className = "gh-cell gh-skel";
            s.setAttribute("aria-hidden", "true");
            frag.appendChild(s);
          }
          grid.appendChild(frag);
        }

        function levelFor(count) {
          if (count <= 0) return 0;
          if (count <= 3) return 1;
          if (count <= 6) return 2;
          if (count <= 9) return 3;
          return 4;
        }

        function colorForLevel(lvl) {
          return LEVELS[lvl];
        }

        function fmtNum(n) {
          return n.toLocaleString("en-US");
        }

        function fmtMonth(date) {
          return date.toLocaleString("en-US", {
            month: "short",
            year: "numeric",
          });
        }

        function fmtBestDate(iso) {
          var d = new Date(iso + "T00:00:00Z");
          return d.toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric",
            timeZone: "UTC",
          });
        }

        function renderError() {
          var err = document.getElementById("gh-error");
          if (err) err.classList.remove("hidden");
        }

        function computeStats(days) {
          var total = 0;
          var bestCount = 0;
          var bestDate = "";
          for (var i = 0; i < days.length; i++) {
            var c = days[i].contributionCount;
            total += c;
            if (c > bestCount) {
              bestCount = c;
              bestDate = days[i].date;
            }
          }
          var longest = 0;
          var run = 0;
          var current = 0;
          for (var j = 0; j < days.length; j++) {
            if (days[j].contributionCount > 0) {
              run++;
              if (run > longest) longest = run;
            } else {
              run = 0;
            }
          }
          for (var k = days.length - 1; k >= 0; k--) {
            if (days[k].contributionCount > 0) current++;
            else break;
          }
          return {
            total: total,
            longest: longest,
            current: current,
            bestCount: bestCount,
            bestDate: bestDate,
          };
        }

        function render(calendar) {
          grid.innerHTML = "";
          var weeks = calendar.weeks || [];
          var flat = [];
          for (var i = 0; i < weeks.length; i++) {
            for (var j = 0; j < weeks[i].contributionDays.length; j++) {
              flat.push(weeks[i].contributionDays[j]);
            }
          }

          var frag = document.createDocumentFragment();
          for (var d = 0; d < flat.length; d++) {
            var day = flat[d];
            var cell = document.createElement("button");
            cell.type = "button";
            cell.className = "gh-cell";
            var lvl = levelFor(day.contributionCount);
            cell.style.background = colorForLevel(lvl);
            cell.setAttribute(
              "aria-label",
              day.date +
                ", " +
                day.contributionCount +
                " contribution" +
                (day.contributionCount === 1 ? "" : "s"),
            );
            cell.title =
              fmtBestDate(day.date) +
              ": " +
              day.contributionCount +
              " contribution" +
              (day.contributionCount === 1 ? "" : "s");
            frag.appendChild(cell);
          }
          grid.appendChild(frag);

          var stats = computeStats(flat);
          var totalEl = document.getElementById("gh-total");
          var curEl = document.getElementById("gh-current");
          var longEl = document.getElementById("gh-longest");
          var bestEl = document.getElementById("gh-best");
          var bestDateEl = document.getElementById("gh-best-date");
          if (totalEl) totalEl.textContent = fmtNum(stats.total);
          if (curEl) curEl.textContent = stats.current;
          if (longEl) longEl.textContent = stats.longest;
          if (bestEl) bestEl.textContent = fmtNum(stats.bestCount);
          if (bestDateEl)
            bestDateEl.textContent = stats.bestDate
              ? fmtBestDate(stats.bestDate)
              : "—";

          if (flat.length > 0) {
            var range = document.getElementById("gh-range");
            if (range) {
              range.textContent =
                fmtMonth(new Date(flat[0].date + "T00:00:00Z")) +
                " — " +
                fmtMonth(new Date(flat[flat.length - 1].date + "T00:00:00Z"));
            }
          }
        }

        function init() {
          paintSkeleton();
          if (typeof fetch !== "function") {
            renderError();
            return;
          }
          var ctrl =
            typeof AbortController === "function"
              ? new AbortController()
              : null;
          var timer = setTimeout(function () {
            if (ctrl) ctrl.abort();
          }, TIMEOUT_MS);
          fetch(ENDPOINT, {
            headers: { Accept: "application/vnd.github+json" },
            signal: ctrl ? ctrl.signal : undefined,
          })
            .then(function (res) {
              if (!res.ok) throw new Error("HTTP " + res.status);
              return res.json();
            })
            .then(function (data) {
              clearTimeout(timer);
              if (!data || !data.contributionCalendar) {
                renderError();
                return;
              }
              render(data.contributionCalendar);
            })
            .catch(function () {
              clearTimeout(timer);
              renderError();
            });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();

      // Coding stats (Wakapi integration with fallback)
      (function () {
        var WAKAPI_ENDPOINT = "";
        var WAKAPI_USERNAME = "";
        var TIMEOUT_MS = 4000;

        var container = document.getElementById("cs-languages");
        if (!container) return;

        var FALLBACK_DATA = {
          languages: [
            { name: "TypeScript", total_seconds: 561600, percent: 32.4 },
            { name: "JavaScript", total_seconds: 352800, percent: 20.3 },
            { name: "Python", total_seconds: 241200, percent: 13.9 },
            { name: "Go", total_seconds: 162000, percent: 9.3 },
            { name: "Rust", total_seconds: 136800, percent: 7.9 },
            { name: "HTML/CSS", total_seconds: 104400, percent: 6.0 },
          ],
          total_seconds: 1735200,
          days_tracked: 90,
        };

        function formatHours(seconds) {
          var hours = Math.floor(seconds / 3600);
          return hours + "h";
        }

        function render(data) {
          container.innerHTML = "";
          var languages = data.languages || [];
          var total = data.total_seconds || 0;
          var days = data.days_tracked || 0;
          var maxPercent = languages.length > 0 ? languages[0].percent : 100;

          var frag = document.createDocumentFragment();
          for (var i = 0; i < languages.length; i++) {
            var lang = languages[i];
            var row = document.createElement("div");
            row.className = "cs-row";
            if (i === languages.length - 1) {
              row.style.borderBottom = "none";
            }

            var rank = document.createElement("span");
            rank.className = "cs-rank";
            rank.textContent = "#" + (i + 1);
            row.appendChild(rank);

            var langCol = document.createElement("div");
            langCol.className = "cs-lang";

            var langName = document.createElement("span");
            langName.className = "cs-lang-name";
            langName.textContent = lang.name;
            langCol.appendChild(langName);

            var bar = document.createElement("div");
            bar.className = "cs-bar";

            var fill = document.createElement("div");
            fill.className = "cs-fill";
            var barWidth = (lang.percent / maxPercent) * 100;
            fill.style.width = barWidth + "%";
            bar.appendChild(fill);
            langCol.appendChild(bar);

            row.appendChild(langCol);

            var time = document.createElement("span");
            time.className = "cs-time";
            time.textContent = formatHours(lang.total_seconds);
            row.appendChild(time);

            var percent = document.createElement("span");
            percent.className = "cs-percent";
            percent.textContent = lang.percent.toFixed(1) + "%";
            row.appendChild(percent);

            frag.appendChild(row);
          }
          container.appendChild(frag);

          var totalEl = document.getElementById("cs-total-hours");
          var daysEl = document.getElementById("cs-days");
          if (totalEl) totalEl.textContent = formatHours(total);
          if (daysEl) daysEl.textContent = days;
        }

        function renderError() {
          var err = document.getElementById("cs-error");
          if (err) err.classList.remove("hidden");
        }

        function init() {
          if (!WAKAPI_ENDPOINT || !WAKAPI_USERNAME) {
            render(FALLBACK_DATA);
            return;
          }

          if (typeof fetch !== "function") {
            render(FALLBACK_DATA);
            return;
          }

          var ctrl =
            typeof AbortController === "function"
              ? new AbortController()
              : null;
          var timer = setTimeout(function () {
            if (ctrl) ctrl.abort();
          }, TIMEOUT_MS);

          var url = WAKAPI_ENDPOINT;
          if (url.indexOf("?") === -1) {
            url += "?username=" + WAKAPI_USERNAME;
          } else {
            url += "&username=" + WAKAPI_USERNAME;
          }

          fetch(url, {
            headers: { Accept: "application/json" },
            signal: ctrl ? ctrl.signal : undefined,
          })
            .then(function (res) {
              if (!res.ok) throw new Error("HTTP " + res.status);
              return res.json();
            })
            .then(function (data) {
              clearTimeout(timer);
              if (!data || !data.languages || !data.languages.length) {
                render(FALLBACK_DATA);
                renderError();
                return;
              }
              var totalSec = 0;
              var langs = data.languages.slice(0, 6);
              for (var i = 0; i < langs.length; i++) {
                totalSec += langs[i].total_seconds;
              }
              var transformed = {
                languages: langs.map(function (l) {
                  return {
                    name: l.name,
                    total_seconds: l.total_seconds,
                    percent:
                      totalSec > 0 ? (l.total_seconds / totalSec) * 100 : 0,
                  };
                }),
                total_seconds: totalSec,
                days_tracked: data.days_tracked || 90,
              };
              render(transformed);
            })
            .catch(function () {
              clearTimeout(timer);
              render(FALLBACK_DATA);
              renderError();
            });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
